/* idea 95: Tauri wrapper config — `npm run tauri dev` once Rust toolchain is set up.
   Builds the Vite output into a desktop .exe for Steam upload. */
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmberQuest 2D",
  "version": "1.0.0",
  "identifier": "com.emberquest.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8123",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EMBERQUEST 2D",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "icon": ["icons/icon.png"]
  }
}